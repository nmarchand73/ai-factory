#!/usr/bin/env python3
"""Map intake's risk and surfaces to the job's agent set.

Usage: route <job-id> [--diff]

Reads `risk` and `surfaces` from intake.md (through job.json), looks them up in
config.json's `routing` and `surface_reviewers` tables, and records the result
in job.json with `job agents`. Prints the agent set.

`route <job-id> --diff` runs at the review stage, once there is a diff: intake judges the issue text, which
can miss what the code really does, so a diff that touches a sensitive path or adds a risky line
(config.json `security_triggers`, plus the target's own `security_paths`) adds the security reviewer. It
only adds, never removes, a reviewer.
"""

import fnmatch
import json
import re
import subprocess
import sys
from pathlib import Path

FACTORY = Path(__file__).resolve().parents[1]
CONFIG = json.loads((FACTORY / "config.json").read_text())


def die(msg):
    print(f"route: {msg}", file=sys.stderr)
    sys.exit(1)


DEFAULT_TRIGGERS = {
    "paths": ["*.sh", "Dockerfile*", ".github/workflows/*", "*.env*", ".gitignore", "*auth*", "*login*", "*secret*"],
    "patterns": [
        r"\binnerHTML\b", r"\bouterHTML\b", r"insertAdjacentHTML", r"document\.write", r"\beval\(", r"new Function\(",
        r"\bpostMessage\(", r"\bfetch\(", r"XMLHttpRequest", r"<script[^>]+src=[\"']?https?:",
        r"<link[^>]+href=[\"']?https?:", r"\bsubprocess\b", r"os\.system", r"shell\s*=\s*True",
        r"api[_-]?key", r"\bsecret\b", r"\bpassword\b", r"\bpasswd\b", r"\bAuthorization\b",
        r"\b(SELECT|INSERT|UPDATE|DELETE)\b.+\b(FROM|INTO|SET)\b"],
}


def diff_triggers(job):
    """What in the branch's diff against its base calls for a security review: [(kind, detail), ...]."""
    target = CONFIG["targets"].get(job["target"], {})
    cfg = {**DEFAULT_TRIGGERS, **CONFIG.get("security_triggers", {})}
    paths = list(cfg["paths"]) + list(target.get("security_paths", []))
    base = f"origin/{target.get('base_branch', 'main')}"
    wt = job["worktree"]

    def git(*a):
        res = subprocess.run(["git", "-C", wt, *a], capture_output=True, text=True)
        if res.returncode != 0:
            die(f"git {' '.join(a)} failed in {wt}: {res.stderr.strip()}")
        return res.stdout

    found = []
    for f in git("diff", "--name-only", f"{base}...HEAD").splitlines():
        hit = next((p for p in paths if fnmatch.fnmatch(f, p) or fnmatch.fnmatch(Path(f).name, p)), None)
        if hit:
            found.append(("path", f"{f} matches {hit}"))
    rx = [re.compile(p, re.I) for p in cfg["patterns"]]
    current = None
    for line in git("diff", "-U0", f"{base}...HEAD").splitlines():
        if line.startswith("+++ "):
            current = line[6:] if line.startswith("+++ b/") else line[4:]
        elif line.startswith("+") and not line.startswith("+++"):
            hit = next((r.pattern for r in rx if r.search(line)), None)
            if hit:
                found.append(("line", f"{current}: {line[1:].strip()[:80]}  ({hit})"))
    return found


def route_diff(job_id):
    job_bin = str(FACTORY / "bin" / "job")
    res = subprocess.run([job_bin, "sync", job_id], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    if job["stage"] != "review" or not job.get("agents"):
        die(f"{job_id} is in {job['stage']}: run `route <job> --diff` once the gate has passed and the job is in review")
    reviewers = dict(job["agents"]["reviewers"])
    extra = CONFIG["surface_reviewers"].get("security", {})
    if all(k in reviewers for k in extra):
        print(f"{job_id}: security already routed")
        return
    found = diff_triggers(job)
    if not found:
        print(f"{job_id}: diff has no security trigger")
        return
    reviewers.update(extra)
    res = subprocess.run([job_bin, "agents", job_id, json.dumps({"reviewers": reviewers})], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    shown = "; ".join(f"{k}: {d}" for k, d in found[:5]) + (f"; +{len(found) - 5} more" if len(found) > 5 else "")
    print(f"{job_id}: security reviewer added by the diff ({shown})")
    print(f"{job_id}: reviewers " + ", ".join(f"{k} {v}" for k, v in reviewers.items()))


def main(argv):
    if len(argv) == 2 and argv[1] == "--diff":
        return route_diff(argv[0])
    if len(argv) != 1:
        die("usage: route <job-id> [--diff]")
    job_id = argv[0]
    job_bin = str(FACTORY / "bin" / "job")
    res = subprocess.run([job_bin, "sync", job_id], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text())
    intake = job["intake"] or die(f"{job_id} has no intake.md")
    risk = CONFIG["routing"].get(intake["risk"]) or die(
        f"risk {intake['risk']!r} isn't in config.json routing ({', '.join(CONFIG['routing'])})")
    reviewers = dict(risk)
    for surface in intake["surfaces"]:
        extra = CONFIG["surface_reviewers"].get(surface)
        if extra is None:
            die(f"surface {surface!r} isn't in config.json surface_reviewers ({', '.join(CONFIG['surface_reviewers'])})")
        reviewers.update(extra)
    agents = {"reviewers": reviewers}
    res = subprocess.run([job_bin, "agents", job_id, json.dumps(agents)], capture_output=True, text=True)
    if res.returncode != 0:
        die(res.stderr.strip())
    print(f"{job_id}: reviewers " + ", ".join(f"{k} {v}" for k, v in reviewers.items()))


if __name__ == "__main__":
    main(sys.argv[1:])
