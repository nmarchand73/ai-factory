{
  "concurrency": 3,
  "max_rounds": 3,
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low": {
      "code": "haiku"
    },
    "medium": {
      "code": "sonnet"
    },
    "high": {
      "code": "sonnet"
    }
  },
  "surface_reviewers": {
    "ui": {
      "ux": "sonnet",
      "ui": "haiku"
    },
    "security": {
      "security": "opus"
    }
  },
  "ports": {
    "base": 5100,
    "step": 10
  },
  "prices_usd_per_mtok": {
    "claude-fable-5-1": {
      "input": 10.0,
      "output": 50.0,
      "cache_write_5m": 12.5,
      "cache_write_1h": 20.0,
      "cache_read": 0.25
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0,
      "cache_write_5m": 5.0,
      "cache_write_1h": 8.0,
      "cache_read": 0.2
    },
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4.0,
      "cache_read": 0.2
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "output": 0.5,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01
    }
  },
  "targets": {
    "sandbox": {
      "repo": "nmarchand73/factory-sandbox",
      "base_branch": "main",
      "merge_method": "squash",
      "protected_paths": [
        ".github/workflows/*"
      ]
    }
  },
  "evals": {
    "weights": {
      "process": 0.4,
      "output": 0.6
    },
    "eval_case_weight": 2,
    "window": 50,
    "prior": 60,
    "prior_strength": 4,
    "min_samples": 3,
    "thresholds": {
      "trusted": 85,
      "ok": 70
    }
  },
  "evolution": {
    "max_changes_per_cycle": 3,
    "measure_min_samples": 3,
    "delivered_fraction": 0.5,
    "regression_points": 3
  }
}
